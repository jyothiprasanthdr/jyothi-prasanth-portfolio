---
import Icon from './Icon.astro';

interface Props {
  home: boolean;
  crumb: { label: string; href?: string }[];
}
const { home, crumb } = Astro.props;
const onResume = Astro.url.pathname.replace(/\.html$/, '') === '/resume';
---

<header class="toolbar">
  <div class="toolbar-inner">
    <div class="toolbar-left">
      <a class="wordmark" href="/" aria-label="Jyothi Prasanth, home">jyothi-prasanth.ipynb</a>
      {
        crumb.length > 0 && (
          <nav class="crumb" aria-label="Breadcrumb">
            <ol>
              {crumb.map((c) => (
                <li>
                  <span aria-hidden="true">/</span>
                  {c.href ? <a href={c.href}>{c.label}</a> : <span aria-current="page">{c.label}</span>}
                </li>
              ))}
            </ol>
          </nav>
        )
      }
    </div>

    {
      home && (
        <button class="btn btn-quiet run-all" type="button" data-run-all>
          <Icon name="play" size={14} />
          Run all
        </button>
      )
    }

    <div class="toolbar-right">
      <span class="kernel" data-kernel>
        <span class="kernel-dot" aria-hidden="true"></span>
        <span class="kernel-label">Available · AI Engineer roles</span>
      </span>
      {/* Secondary: each page keeps its own single primary action. Hidden on the resume itself. */}
      {!onResume && <a class="btn btn-secondary" href="/resume">Resume</a>}
      {
        home && (
          <button class="btn btn-secondary contents-btn" type="button" data-open-contents aria-haspopup="dialog">
            <Icon name="list" size={16} />
            <span class="contents-label">Contents</span>
          </button>
        )
      }
    </div>
  </div>
</header>

<style>
  .toolbar {
    position: sticky;
    top: 0;
    z-index: 10;
    height: var(--toolbar-h);
    background: color-mix(in srgb, var(--ground) 94%, transparent);
    backdrop-filter: saturate(1.2) blur(8px);
    border-bottom: 1px solid var(--rule);
  }

  .toolbar-inner {
    max-width: 1120px;
    height: 100%;
    margin: 0 auto;
    padding: 0 24px;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 16px;
  }

  .toolbar-left {
    display: flex;
    align-items: center;
    gap: 8px;
    min-width: 0;
  }

  .wordmark {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    font-weight: 500;
    text-decoration: none;
    white-space: nowrap;
  }

  .crumb ol {
    display: flex;
    gap: 8px;
    padding: 0;
    list-style: none;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--ink-2);
    white-space: nowrap;
    overflow: hidden;
  }

  .crumb li {
    display: flex;
    gap: 8px;
    min-width: 0;
  }

  .crumb [aria-current] {
    overflow: hidden;
    text-overflow: ellipsis;
    color: var(--ink);
  }

  .run-all {
    justify-self: center;
    font-size: var(--text-sm);
  }

  .toolbar-right {
    grid-column: 3;
    justify-self: end;
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .kernel {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: var(--text-xs);
    color: var(--ink-2);
    white-space: nowrap;
  }

  /* Jupyter's kernel indicator: hollow when idle, filled while cells run. */
  .kernel-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    border: 1.5px solid var(--ink-2);
    transition: background-color 150ms ease;
  }

  :global([data-kernel][data-busy]) .kernel-dot {
    background: var(--ink-2);
  }

  .contents-btn {
    display: none;
  }

  @media (max-width: 1023px) {
    .kernel {
      display: none;
    }
  }

  @media (max-width: 859px) {
    .toolbar-inner {
      grid-template-columns: 1fr auto;
      padding: 0 16px;
    }

    .toolbar-right {
      grid-column: 2;
      gap: 8px;
    }

    .run-all,
    .crumb {
      display: none;
    }

    .contents-btn {
      display: inline-flex;
    }
  }

  @media (max-width: 479px) {
    .contents-btn {
      width: 44px;
      padding: 0;
      justify-content: center;
    }

    .contents-label {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
      white-space: nowrap;
    }
  }
</style>
