---
import Icon from './Icon.astro';

interface Props {
  items: { n: number; id: string; label: string }[];
}
const { items } = Astro.props;
---

<nav class="rail" aria-label="Notebook contents">
  <p class="rail-title">Contents</p>
  <ol>
    {
      items.map((item) => (
        <li>
          <a href={`#${item.id}`} data-rail-link={item.id}>
            <span class="rail-count" aria-hidden="true">{item.n}</span>
            <span>{item.label}</span>
          </a>
        </li>
      ))
    }
  </ol>
  <button class="rail-keys" type="button" data-open-shortcuts>
    <Icon name="keyboard" size={14} />
    Keyboard shortcuts
  </button>
</nav>

<dialog class="sheet" id="contents-dialog" aria-labelledby="contents-dialog-title">
  <div class="sheet-head">
    <h2 id="contents-dialog-title">Contents</h2>
    <button class="btn btn-quiet sheet-close" type="button" data-close-dialog aria-label="Close contents">
      <Icon name="x" size={18} />
    </button>
  </div>
  <ol class="sheet-list">
    {
      items.map((item) => (
        <li>
          <a href={`#${item.id}`} data-close-dialog>
            <span class="rail-count" aria-hidden="true">{item.n}</span>
            {item.label}
          </a>
        </li>
      ))
    }
  </ol>
</dialog>

<dialog class="sheet" id="shortcuts-dialog" aria-labelledby="shortcuts-dialog-title">
  <div class="sheet-head">
    <h2 id="shortcuts-dialog-title">Keyboard shortcuts</h2>
    <button class="btn btn-quiet sheet-close" type="button" data-close-dialog aria-label="Close keyboard shortcuts">
      <Icon name="x" size={18} />
    </button>
  </div>
  <dl class="keys">
    <div><dt><kbd>j</kbd></dt><dd>Next cell</dd></div>
    <div><dt><kbd>k</kbd></dt><dd>Previous cell</dd></div>
    <div><dt><kbd>Shift</kbd> + <kbd>Enter</kbd></dt><dd>Next cell</dd></div>
    <div><dt><kbd>r</kbd></dt><dd>Open the resume</dd></div>
    <div><dt><kbd>?</kbd></dt><dd>Show this list</dd></div>
  </dl>
</dialog>

<style>
  .rail {
    position: sticky;
    top: calc(var(--toolbar-h) + 32px);
    align-self: start;
    padding-top: 16px;
  }

  .rail-title {
    font-size: var(--text-xs);
    font-weight: 500;
    color: var(--ink-2);
    margin-bottom: 12px;
  }

  .rail ol,
  .sheet-list {
    list-style: none;
    padding: 0;
  }

  .rail a {
    display: flex;
    align-items: baseline;
    gap: 10px;
    padding: 5px 0;
    font-size: var(--text-sm);
    color: var(--ink-2);
    text-decoration: none;
    transition: color 120ms ease;
  }

  .rail a[aria-current='true'] {
    color: var(--ink);
  }

  @media (hover: hover) and (pointer: fine) {
    .rail a:hover {
      color: var(--ink);
    }
  }

  .rail-count {
    min-width: 22px;
    text-align: center;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--ink-3);
    font-variant-numeric: tabular-nums;
  }

  /* The now-marker: the only use of the accent in the rail, always with ink text. */
  .rail a[aria-current='true'] .rail-count {
    background: var(--signal);
    color: var(--ink);
    border-radius: var(--radius-sm);
    padding: 0 5px;
  }

  .rail-keys {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-top: 24px;
    padding: 0;
    border: 0;
    background: none;
    font: inherit;
    font-size: var(--text-xs);
    color: var(--ink-2);
    cursor: pointer;
  }

  @media (hover: hover) and (pointer: fine) {
    .rail-keys:hover {
      color: var(--ink);
    }
  }

  @media (max-width: 859px) {
    .rail {
      display: none;
    }
  }

  /* ---------- Dialogs ---------- */
  .sheet {
    width: min(420px, calc(100vw - 32px));
    padding: 0;
    border: 1px solid var(--rule-strong);
    border-radius: var(--radius-md);
    background: var(--surface);
    color: var(--ink);
    opacity: 1;
    transform: none;
    transition:
      opacity 200ms var(--ease-out),
      transform 200ms var(--ease-out),
      overlay 200ms allow-discrete,
      display 200ms allow-discrete;
  }

  @starting-style {
    .sheet[open] {
      opacity: 0;
      transform: translateY(-4px);
    }
  }

  .sheet:not([open]) {
    opacity: 0;
    transition-duration: 150ms;
  }

  .sheet::backdrop {
    background: rgb(27 28 30 / 0.32);
  }

  .sheet-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 12px 12px 12px 20px;
    border-bottom: 1px solid var(--rule);
  }

  .sheet-head h2 {
    font-size: var(--text-md);
  }

  .sheet-close {
    width: 44px;
    padding: 0;
    justify-content: center;
  }

  .sheet-list {
    padding: 8px 8px 12px;
  }

  .sheet-list a {
    display: flex;
    align-items: baseline;
    gap: 12px;
    padding: 12px;
    min-height: 44px;
    text-decoration: none;
    border-radius: var(--radius-sm);
  }

  .keys {
    padding: 12px 20px 20px;
  }

  .keys div {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding: 8px 0;
    border-bottom: 1px solid var(--rule);
  }

  .keys div:last-child {
    border-bottom: 0;
  }

  .keys dd {
    color: var(--ink-2);
  }

  kbd {
    display: inline-block;
    min-width: 24px;
    padding: 1px 6px;
    border: 1px solid var(--rule-strong);
    border-radius: var(--radius-sm);
    background: var(--code-bg);
    font-size: var(--text-xs);
    text-align: center;
  }
</style>
