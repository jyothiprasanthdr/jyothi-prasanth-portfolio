---
// The hero object: real handwritten pages stacked in 3D with CSS transforms (no WebGL).
// Depth comes from overlap and a tone step per sheet, never from shadows.
import { notebooks, pageUrl } from '../lib/notes';

// Back to front. The top sheet is the one people read first.
const ORDER = ['kubernetes', 'rag', 'parameter-efficient-fine-tuning', 'chunking-techniques-for-rag', 'langgraph'];
const sheets = ORDER.map((slug) => notebooks.find((n) => n.slug === slug))
  .filter((n) => n !== undefined)
  .map((nb, i, all) => ({ nb, depth: all.length - 1 - i, src: i === all.length - 1 ? nb.shelf : pageUrl(nb.slug, nb.firstPage) }));
const totalPages = notebooks.reduce((sum, n) => sum + n.pages, 0);
---

<a class="stack" href="/notes" data-stack aria-label={`Open all ${notebooks.length} handwritten notebooks`}>
  <span class="scene" aria-hidden="true">
    <span class="body" data-stack-body>
      {
        sheets.map((s) => (
          <img
            class="sheet"
            style={`--d:${s.depth}`}
            src={s.src}
            alt=""
            width="440"
            height="568"
            loading="eager"
            decoding="async"
            fetchpriority={s.depth === 0 ? 'high' : 'low'}
          />
        ))
      }
    </span>
  </span>
  <span class="caption mono">{notebooks.length} notebooks, {totalPages} pages</span>
</a>

<style>
  .stack {
    display: grid;
    justify-items: center;
    gap: 12px;
    text-decoration: none;
    color: var(--ink-2);
    -webkit-tap-highlight-color: transparent;
  }

  .scene {
    display: grid;
    place-items: center;
    width: 100%;
    aspect-ratio: 1 / 1.2;
    perspective: 1300px;
  }

  .body {
    --tx: 0deg;
    --ty: 0deg;
    position: relative;
    width: 70%;
    margin: 12% 30% 0 0;
    aspect-ratio: 1100 / 1420;
    transform-style: preserve-3d;
    transform: rotateX(calc(14deg + var(--ty))) rotateY(calc(-22deg + var(--tx))) rotateZ(4deg);
    transition: transform 700ms var(--ease-out);
  }

  .sheet {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
    background: var(--surface);
    border: 1px solid var(--rule-strong);
    border-radius: var(--radius-sm);
    /* Each sheet sits a step further back, down, and darker: overlap and tone, not shadow. */
    transform: translate3d(calc(var(--d) * 6px), calc(var(--d) * -8px), calc(var(--d) * -30px)) rotateZ(calc(var(--d) * 2deg));
    filter: brightness(calc(1 - var(--d) * 0.035));
    transition: transform 520ms var(--ease-out);
  }

  .caption {
    font-size: var(--text-xs);
    transition: color 150ms ease;
  }

  /* Pointer devices: the stack fans open so you can see there is more than one page. */
  @media (hover: hover) and (pointer: fine) {
    .stack:hover .sheet,
    .stack:focus-visible .sheet {
      transform: translate3d(calc(var(--d) * 20px), calc(var(--d) * -16px), calc(var(--d) * -60px)) rotateZ(calc(var(--d) * 4deg));
    }

    .stack:hover .caption {
      color: var(--ink);
    }
  }

  .stack:active .body {
    transform: rotateX(calc(14deg + var(--ty))) rotateY(calc(-22deg + var(--tx))) rotateZ(4deg) scale(0.97);
    transition-duration: 160ms;
  }

  .stack:focus-visible {
    outline: none;
  }

  .stack:focus-visible .caption {
    outline: 2px solid var(--ink);
    outline-offset: 3px;
    border-radius: 2px;
    color: var(--ink);
  }

  /* Entrance: sheets are dealt back to front. Uses the separate `translate` property so it never
     fights the resting transform. */
  @media (prefers-reduced-motion: no-preference) {
    .sheet {
      animation: deal 560ms var(--ease-out) backwards;
      animation-delay: calc(120ms + (4 - var(--d)) * 70ms);
    }

    @keyframes deal {
      from {
        opacity: 0;
        translate: 0 -28px;
      }
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .body,
    .sheet {
      transition: none;
    }
  }
</style>
