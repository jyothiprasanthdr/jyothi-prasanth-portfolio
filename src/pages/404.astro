---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found · Jyothi Prasanth D R" description="This page doesn't exist.">
  <div class="missing">
    <p class="prompt mono" aria-hidden="true">[ ]</p>
    <div class="error">
      <h1>This page doesn't exist.</h1>
      <p>The link may be old or mistyped.</p>
      <ul role="list">
        <li><a href="/">Home</a></li>
        <li><a href="/notes">Notebooks</a></li>
        <li><a href="/resume">Resume</a></li>
      </ul>
    </div>
  </div>
</Base>

<style>
  .missing {
    max-width: 760px;
    margin: 0 auto;
    padding: 64px 24px 0;
    display: grid;
    grid-template-columns: 48px 1fr;
    gap: 16px;
  }

  .prompt {
    padding-top: 18px;
    font-size: var(--text-xs);
    color: var(--ink-3);
    text-align: right;
  }

  /* Jupyter's error output: a block on the code background. */
  .error {
    padding: 20px 24px;
    background: var(--code-bg);
    border: 1px solid var(--rule-strong);
    border-radius: var(--radius-md);
  }

  h1 {
    font-size: var(--text-xl);
  }

  p {
    margin-top: 8px;
    color: var(--ink-2);
  }

  ul {
    display: flex;
    gap: 20px;
    padding: 0;
    margin-top: 20px;
    list-style: none;
  }

  @media (max-width: 480px) {
    .missing {
      grid-template-columns: 1fr;
      padding: 40px 16px 0;
    }

    .prompt {
      display: none;
    }
  }
</style>
