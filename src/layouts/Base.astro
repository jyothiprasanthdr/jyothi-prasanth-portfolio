---
import '@fontsource-variable/geist';
import '@fontsource-variable/geist-mono';
import '../styles/global.css';
import Toolbar from '../components/Toolbar.astro';
import { profile } from '../data/profile';

interface Props {
  title: string;
  description: string;
  home?: boolean;
  crumb?: { label: string; href?: string }[];
}

const { title, description, home = false, crumb = [] } = Astro.props;
// Pages build as name.html (build.format 'file') but are served without the extension.
const cleanPath = Astro.url.pathname.replace(/(index)?\.html$/, '').replace(/(.)\/$/, '$1');
const canonical = Astro.site ? new URL(cleanPath || '/', Astro.site).href : undefined;
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f7f7f4" />
    <meta name="color-scheme" content="light" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta name="twitter:card" content="summary" />
    {
      home && (
        <script is:inline>
          // First visit with motion allowed: mark the notebook as not yet run, before first paint.
          // Content stays in the HTML; if the enhancement script never loads, this reverts after 4s.
          (function () {
            try {
              var root = document.documentElement;
              // Deep links skip the cascade: the visitor came for one section.
              if (location.hash || matchMedia('(prefers-reduced-motion: reduce)').matches || sessionStorage.getItem('nb-ran')) return;
              root.dataset.run = 'pending';
              setTimeout(function () {
                if (root.dataset.run === 'pending') delete root.dataset.run;
              }, 4000);
            } catch (e) {}
          })();
        </script>
      )
    }
    {
      home && (
        <script
          type="application/ld+json"
          set:html={JSON.stringify({
            '@context': 'https://schema.org',
            '@type': 'Person',
            name: profile.name,
            jobTitle: profile.role,
            email: `mailto:${profile.email}`,
            sameAs: [profile.links.github, profile.links.linkedin],
          })}
        />
      )
    }
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Toolbar home={home} crumb={crumb} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="footer-inner">
        <span>© {year} {profile.name}</span>
        <nav aria-label="Footer">
          <a href={profile.links.github} rel="noopener" target="_blank">GitHub<span class="visually-hidden"> (opens in new tab)</span></a>
          <a href={profile.links.linkedin} rel="noopener" target="_blank">LinkedIn<span class="visually-hidden"> (opens in new tab)</span></a>
          <a href={`mailto:${profile.email}`}>Email</a>
          <a href="/notes">Notes</a>
        </nav>
      </div>
    </footer>
  </body>
</html>

<style>
  main:focus {
    outline: none;
  }

  .site-footer {
    border-top: 1px solid var(--rule);
    margin-top: 96px;
  }

  .footer-inner {
    max-width: 1120px;
    margin: 0 auto;
    padding: 24px;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 12px 24px;
    font-size: var(--text-sm);
    color: var(--ink-2);
  }

  .footer-inner nav {
    display: flex;
    gap: 20px;
  }
</style>
